# Supabase Configuration
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json


# Database connection strings
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Backend Host & CORS Configuration (Render assigns PORT automatically)
PORT=8000
FRONTEND_URL=https://your-frontend-site.onrender.com
ALLOWED_ORIGINS=https://your-frontend-site.onrender.com,http://localhost:5173

# PyTorch Deep Learning Model Configuration (leave unset on Render)
# ACCIDENT_MODEL_PATH=./backend/resqroute_accident_model.pt
# MODEL_CONFIG_PATH=./backend/model_config.json

# Frontend (Vite) Environment Variables
VITE_API_URL=https://your-backend-api.onrender.com
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Deployment & Storage Configuration (placeholders only)
RESQ_SECRET_SALT=change-me-long-random-string
MODEL_DOWNLOAD_URL=https://your-storage-host/path/resqroute_accident_model.pt
MODEL_SHA256=5b40e474adeeb6225eb4228055d90f836f92c28cce109d497c423676e7851711
MODEL_DOWNLOAD_TOKEN=optional-bearer-token-for-private-bucket
PYTHON_VERSION=3.12.3
